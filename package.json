{
  "name": "tawdif-desktop",
  "version": "0.1.0",
  "description": "مساعد ترتيب رغبات منصة توظيف الأساتذة",
  "main": "desktop.js",
  "author": "Tawdif",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:x64 && npm run dist:x86",
    "dist:x64": "electron-builder --win nsis --x64",
    "dist:x86": "electron-builder --win nsis --ia32",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "dz.tawdif.assistant",
    "productName": "مساعد الرغبات",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop.js",
      "desktop-preload.js",
      "desktop.html",
      "desktop-controls.js",
      "activation.js",
      "desktop.css",
      "content.js",
      "popup.html",
      "popup.js",
      "popup.css",
      "manifest.json",
      "mock-platform.html",
      "data/**/*",
      "icons/**/*",
      "README.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مساعد الرغبات",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico"
    }
  },
  "devDependencies": {
    "app-builder-bin": "^5.0.0-alpha.10",
    "electron": "22.3.27",
    "electron-builder": "^25.1.8"
  }
}
